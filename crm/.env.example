# ===== CRM WhatsApp — variáveis de ambiente =====
# Copie para .env e preencha. NUNCA versionar o .env (já ignorado no .gitignore da raiz).
#
# ⚠️ Este arquivo serve ao docker-compose de TESTE LOCAL. Em produção (Easypanel)
#    cada serviço tem suas próprias variáveis no painel — ver EASYPANEL.md.

# --- Postgres ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=troque-esta-senha

# --- WhatsApp Cloud API (oficial da Meta) ---
# Tudo isso sai do painel do app em developers.facebook.com, no caso de uso
# "Conectar-se com os clientes pelo WhatsApp".
#
# ID do número (não é o telefone — é um número longo, mostrado na API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta do WhatsApp Business (WABA).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token de acesso. O da tela de teste dura 24h — em produção, gere um permanente
# por Usuário do Sistema no portfólio empresarial.
WHATSAPP_ACCESS_TOKEN=
# Token que VOCÊ inventa e repete no painel da Meta ao cadastrar o webhook.
# A Meta devolve ele no GET de verificação; se não bater, o cadastro falha.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-por-uma-string-aleatoria
# App Secret (Configurações do app > Básico). Valida a assinatura do webhook.
# Sem ele, em produção o webhook recusa tudo — é proposital.
WHATSAPP_APP_SECRET=
# Versão da Graph API. Confira a atual no painel antes de mudar.
WHATSAPP_API_VERSION=v23.0

# --- IA (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do atendimento. Haiku p/ custo; Sonnet p/ qualidade. Ver skill claude-api.
AI_MODEL=claude-haiku-4-5

# --- Painel CRM ---
# Segredo da sessão (iron-session). Mínimo 32 caracteres. Gere aleatório.
SESSION_SECRET=troque-por-32-caracteres-ou-mais-aleatorio
ADMIN_EMAIL=hervessonporto@gmail.com
# Hash bcrypt da senha do painel. Gere com: node crm-web/scripts/hash-senha.mjs "suaSenha"
ADMIN_PASSWORD_HASH=$2b$10$...
# URL pública do painel. Local: http://localhost:3000. Produção: domínio do Easypanel.
# É a base do webhook: <PUBLIC_PANEL_URL>/api/whatsapp/webhook
PUBLIC_PANEL_URL=http://localhost:3000
# Origem permitida no CORS do endpoint público de captura de lead (o site na Vercel).
CORS_ALLOW_ORIGIN=https://www.trinctecnologies.com.br
